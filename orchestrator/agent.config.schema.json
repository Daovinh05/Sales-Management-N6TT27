{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Team Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["openai", "opencode", "mock"] },
        "baseUrl": { "type": "string" },
        "model": { "type": "string" },
        "apiKeyEnv": { "type": "string" },
        "opencodeServerUrl": { "type": "string" },
        "opencodeUsername": { "type": "string" },
        "opencodePassword": { "type": "string" },
        "fallbackBaseUrl": { "type": "string" },
        "fallbackModel": { "type": "string" },
        "fallbackApiKey": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxTokens": { "type": "integer", "minimum": 256 },
        "timeoutMs": { "type": "integer", "minimum": 1000 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxStepsPerTask": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxTaskAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxFixCycles": { "type": "integer", "minimum": 0, "maximum": 10 },
        "taskTimeoutMs": { "type": "integer", "minimum": 10000 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxToolOutputChars": { "type": "integer", "minimum": 1000 },
        "maxFileWriteBytes": { "type": "integer", "minimum": 1000 },
        "maxContextChars": { "type": "integer", "minimum": 2000 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["gate", "auto", "deny"] }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedRoots": { "type": "array", "items": { "type": "string" } },
        "protectedPaths": { "type": "array", "items": { "type": "string" } },
        "excludeDirs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shellAllowlist": { "type": "array", "items": { "type": "string" } },
        "denyPatterns": { "type": "array", "items": { "type": "string" } },
        "approvalPatterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["cwd", "command"],
        "additionalProperties": false,
        "properties": {
          "cwd": { "type": "string" },
          "command": { "type": "string" },
          "timeoutMs": { "type": "integer", "minimum": 1000 },
          "description": { "type": "string" }
        }
      }
    },
    "reporter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["vi", "en"] },
        "aiSummary": { "type": "boolean" }
      }
    }
  }
}
