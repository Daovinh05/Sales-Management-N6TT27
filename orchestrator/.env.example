# =====================================================================
# Cấu hình LLM cho hệ thống Agent (copy file này thành .env)
# .env KHÔNG được commit. Không đưa key thật vào agent.config.json.
# =====================================================================

# Provider: openai | opencode | mock
LLM_PROVIDER=openai

# Base URL tương thích OpenAI (giữ nguyên /v1 nếu provider yêu cầu)
# OpenAI:     https://api.openai.com/v1
# DeepSeek:   https://api.deepseek.com/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# Model dùng cho cả planner và 4 agent
LLM_MODEL=deepseek-chat

# --- Google Gemini (free tier) ---
# Lấy key tại https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash

# --- OpenCode local server (dùng OAuth đã đăng nhập trong OpenCode) ---
# Kết nối trước trong OpenCode bằng /connect (GitHub Copilot hoặc OpenAI/ChatGPT),
# rồi mở server: opencode serve --port 4096
# Xem tên model có quyền dùng: opencode models
# LLM_PROVIDER=opencode
# LLM_OPENCODE_SERVER_URL=http://127.0.0.1:4096
# Ví dụ định dạng: github-copilot/<model-id> hoặc openai/<model-id>
# LLM_MODEL=github-copilot/<model-id>
# Nếu server bật basic auth thì đặt cả username và password:
# LLM_OPENCODE_USERNAME=opencode
# LLM_OPENCODE_PASSWORD=

# --- Ollama local (không cần API key) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama

# Tên biến môi trường chứa API key (mặc định LLM_API_KEY)
# Có thể đặt trực tiếp key vào LLM_API_KEY bên dưới.
LLM_API_KEY=

# Provider dự phòng tùy chọn; dùng endpoint/model/key khác khi primary bận hoặc mất kết nối.
# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_MODEL=gpt-4.1-mini
# LLM_FALLBACK_API_KEY=

# Tuỳ chọn: temperature thấp để code ổn định
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=120000

# Approval: gate (hỏi khi nguy hiểm) | auto (tự duyệt) | deny (chặn hẳn)
AGENT_APPROVAL_MODE=gate

# Số task chạy song song tối đa (1..8). Mỗi role chỉ chạy một task trong một batch.
# Đặt 1 nếu các agent có thể sửa cùng file dùng chung.
AGENT_MAX_PARALLEL=1

# Thư mục lưu run (mặc định: orchestrator/runs)
# ORCHESTRATOR_RUNS_DIR=

# Báo cáo trạng thái run lên Telegram sau khi hoàn tất hoặc chờ duyệt.
# Tạo bot qua @BotFather, lấy chat ID của cuộc trò chuyện nhận tin.
TELEGRAM_NOTIFY=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
