%%{init: {'theme': 'base', 'themeVariables': {'background': '#FFFFFF', 'primaryColor': '#FFFFFF', 'primaryTextColor': '#111827', 'primaryBorderColor': '#3B82F6', 'lineColor': '#64748B', 'textColor': '#111827', 'fontSize': '14px'}}}%%
flowchart TB

    %% =========================
    %% BRIGHT THEME
    %% =========================
    classDef client fill:#FEF9C3,stroke:#CA8A04,stroke-width:2px,color:#111827;
    classDef frontend fill:#CFFAFE,stroke:#0891B2,stroke-width:2px,color:#111827;
    classDef backend fill:#DBEAFE,stroke:#2563EB,stroke-width:2px,color:#111827;
    classDef service fill:#EDE9FE,stroke:#7C3AED,stroke-width:2px,color:#111827;
    classDef data fill:#DCFCE7,stroke:#16A34A,stroke-width:2px,color:#111827;
    classDef external fill:#FCE7F3,stroke:#DB2777,stroke-width:2px,color:#111827;

    %% ==========================================
    %% CLIENT
    %% ==========================================

    subgraph CLIENT["CLIENT"]
        Customer["Customer"]
        Admin["Admin"]
        Warehouse["Warehouse Staff"]

        Browser["Web Browser"]

        Customer --> Browser
        Admin --> Browser
        Warehouse --> Browser
    end


    %% ==========================================
    %% FRONTEND
    %% ==========================================

    subgraph FRONTEND["FRONTEND - REACT"]

        UI["React UI"]

        Pages["Pages"]
        Components["Components"]
        Services["API Services"]
        State["State Management"]

        UI --> Pages
        UI --> Components
        UI --> Services
        UI --> State

    end


    %% ==========================================
    %% BACKEND
    %% ==========================================

    subgraph BACKEND["BACKEND - SPRING BOOT"]

        Gateway["API / Controller"]

        Security["Spring Security"]
        JWT["JWT Authentication"]

        ProductService["Product Service"]
        UserService["User Service"]
        OrderService["Order Service"]
        CartService["Cart Service"]
        PaymentService["Payment Service"]
        WarehouseService["Warehouse Service"]
        ReportService["Report Service"]

        Repository["Spring Data JPA / Repository"]

        Gateway --> Security
        Security --> JWT

        Gateway --> ProductService
        Gateway --> UserService
        Gateway --> OrderService
        Gateway --> CartService
        Gateway --> PaymentService
        Gateway --> WarehouseService
        Gateway --> ReportService

        ProductService --> Repository
        UserService --> Repository
        OrderService --> Repository
        CartService --> Repository
        PaymentService --> Repository
        WarehouseService --> Repository
        ReportService --> Repository

    end


    %% ==========================================
    %% DATABASE
    %% ==========================================

    subgraph DATA["DATA LAYER"]

        MySQL[("MySQL / PostgreSQL")]

        Redis[("Redis Cache")]

    end


    %% ==========================================
    %% EXTERNAL SERVICES
    %% ==========================================

    subgraph EXTERNAL["EXTERNAL SERVICES"]

        PaymentGateway["Payment Gateway"]

        Email["Email Service"]

    end


    %% ==========================================
    %% CONNECTION
    %% ==========================================

    Browser --> UI

    Services --> Gateway

    Repository --> MySQL

    ProductService --> Redis
    CartService --> Redis

    PaymentService --> PaymentGateway

    OrderService --> Email
    PaymentService --> Email

    %% =========================
    %% APPLY COLORS
    %% =========================
    class Customer,Admin,Warehouse,Browser client;
    class UI,Pages,Components,Services,State frontend;
    class Gateway,Security,JWT,Repository backend;
    class ProductService,UserService,OrderService,CartService,PaymentService,WarehouseService,ReportService service;
    class MySQL,Redis data;
    class PaymentGateway,Email external;

    style CLIENT fill:#FFFBEB,stroke:#CA8A04,stroke-width:2px,color:#111827;
    style FRONTEND fill:#ECFEFF,stroke:#0891B2,stroke-width:2px,color:#111827;
    style BACKEND fill:#EFF6FF,stroke:#2563EB,stroke-width:2px,color:#111827;
    style DATA fill:#F0FDF4,stroke:#16A34A,stroke-width:2px,color:#111827;
    style EXTERNAL fill:#FDF2F8,stroke:#DB2777,stroke-width:2px,color:#111827;

    linkStyle default stroke:#64748B,stroke-width:2px;