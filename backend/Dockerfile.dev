FROM maven:3.9-eclipse-temurin-21

RUN apt-get update \
    && apt-get install -y --no-install-recommends inotify-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
EXPOSE 8080

CMD ["sh", "-c", "(while inotifywait -q -r -e close_write,create,delete,move src/main/java src/main/resources; do mvn -q compile || echo 'Backend compilation failed; fix the source and save again.'; done) & exec mvn spring-boot:run"]
